---
import '@/styles/tokens.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Analytics from '@/components/Analytics.astro';
import { getLangFromUrl, useTranslations, stripLang } from '@/i18n/utils';
import { SITE, clampDescription, pageTitle } from '@/lib/seo';
import company from '@/data/company.json';

interface Props {
  /** Page name. `| Vithean` is appended unless `home` is set. */
  title: string;
  /** REQUIRED. Every page states what it is for — never a reused lead paragraph. */
  description: string;
  /** Path without the locale prefix, e.g. 'pricing/'. Drives canonical + hreflang. */
  route?: string;
  home?: boolean;
  /** Extra JSON-LD blocks for this page. */
  schemas?: unknown[];
  ogType?: 'website' | 'article';
  /**
   * Set when the page exists in one language only. hreflang is a promise that
   * the other URL exists; on a page built for a single locale that promise is
   * false, and Google treats an alternate pointing at a 404 as an error on the
   * page that made the claim.
   */
  onlyLang?: 'en' | 'km';
}
const { title, description, route = '', home = false, schemas = [], ogType = 'website',
        onlyLang } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://vithean.com');

const fullTitle = pageTitle(title, { home });
const desc = clampDescription(description || SITE.defaultDescription);

/** English is unprefixed; only Khmer carries /km/. */
const urlFor = (l: 'en' | 'km') => new URL(l === 'en' ? `/${route}` : `/km/${route}`, site).href;
const canonical = urlFor(lang);
const ogImage = new URL(SITE.ogImage, site).href;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: company.brand,
  legalName: company.legalName,
  description: SITE.defaultDescription,
  url: site.href,
  logo: { '@type': 'ImageObject', url: new URL('/assets/logo-full.png', site).href },
  image: ogImage,
  email: company.contact.email,
  telephone: company.contact.phonePrimary.replace(/\s/g, '-'),
  foundingDate: company.launchDate,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3E:Fii Building, 6th Floor, Street Vimean Ahha, Kien Klaing Village',
    addressLocality: 'Sangkat Chroy Changva, Khan Chroy Changvar',
    addressRegion: 'Phnom Penh',
    addressCountry: 'KH',
  },
  areaServed: { '@type': 'Country', name: 'Cambodia' },
  location: {
    '@type': 'Place',
    name: '3E:Fii Building',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Street Vimean Ahha, Kien Klaing Village',
      addressLocality: 'Sangkat Chroy Changva, Khan Chroy Changvar',
      addressRegion: 'Phnom Penh',
      addressCountry: 'KH',
    },
    hasMap: company.contact.mapUrl,
  },
  knowsLanguage: ['en', 'km'],
  sameAs: Object.values(company.social),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', site).href,
  name: SITE.name,
  alternateName: SITE.category,
  description: SITE.defaultDescription,
  url: site.href,
  inLanguage: ['en-US', 'km-KH'],
  publisher: { '@id': new URL('/#organization', site).href },
};
---
<!doctype html>
<html lang={lang === 'km' ? 'km-KH' : 'en-US'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {/*
    Applies the stored theme before the first paint. It has to be inline and
    synchronous in <head>: deferred or bundled, the browser paints the light
    palette first and a dark-mode visitor sees a white flash on every
    navigation. No stored choice means no attribute, which leaves the
    prefers-color-scheme media query in charge — "System" is the default and
    is not written to storage.
  */}
  <script is:inline>
    try {
      var m = localStorage.getItem('vth-theme');
      if (m !== 'dark' && m !== 'light') {
        /* Resolve the OS preference to a concrete value rather than leaving the
           attribute off. PrimeVue themes its dark scheme from a single CSS
           selector and cannot read a media query, so "no attribute" would leave
           the Vue components light on a dark page — which is how the support
           FAQ came out unreadable. */
        m = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = m;
    } catch (e) { /* private mode: the CSS media query still covers the page */ }
  </script>

  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />

  {/* A single-language page advertises no translation. */}
  {(!onlyLang || onlyLang === 'en') && <link rel="alternate" hreflang="en" href={urlFor('en')} />}
  {(!onlyLang || onlyLang === 'km') && <link rel="alternate" hreflang="km" href={urlFor('km')} />}
  <link rel="alternate" hreflang="x-default" href={urlFor(onlyLang ?? 'en')} />

  <link rel="icon" href="/assets/logo-icon.png" />
  <link rel="preload" href="/fonts/mukta-400.woff2" as="font" type="font/woff2" crossorigin />
  {/* Kantumruy is preloaded on EVERY page, English included. The language
      switcher itself renders ខ្មែរ, Khmer article titles appear in the English
      news list, and Khmer business names turn up inside English copy — in
      Cambodia that is the normal case, not the exception. */}
  <link rel="preload" href="/fonts/kantumruy-pro-400.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={lang === 'km' ? 'km_KH' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'km' ? 'en_US' : 'km_KH'} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
  <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
  <meta property="og:image:alt" content={`${SITE.name} — ${SITE.category}`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />

  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

  {/*
    Suppress the browser's "translate this page?" prompt on the Khmer routes.
    We publish a real English version and link it from the header, so a
    machine translation of our Khmer is strictly worse than the page the
    switcher already offers — and Chrome will sometimes translate without
    being asked. Only /km/: the English pages stay translatable, because a
    reader of a language we do not publish still needs Translate to use them.
  */}
  {lang === 'km' && <meta name="google" content="notranslate" />}

  {/*
    The /en/ loop breaker lands here with ?nocache=1 to dodge a cached redirect
    from the old site. It has done its job by the time the page renders, so the
    URL is tidied with replaceState — no reload, no new history entry, and the
    visitor never sees the marker in a link they might copy.
  */}
  <script is:inline>
    if (location.search.indexOf('nocache=1') !== -1) {
      try {
        var u = new URL(location.href);
        u.searchParams.delete('nocache');
        history.replaceState(null, '', u.pathname + (u.search || '') + u.hash);
      } catch (e) { /* older browser: the marker is harmless */ }
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <Analytics />
</head>
<body>
  <a href="#main" class="skip">{t('a11y.skip')}</a>
  <SiteHeader />
  <main id="main"><slot /></main>
  <SiteFooter />
</body>
</html>

<style is:global>
  .skip{position:absolute; left:-9999px; top:0; background:var(--plum-600); color:var(--on-plum);
    padding:.6rem 1rem; z-index:100; border-radius:0 0 var(--r-sm) 0}
  .skip:focus{left:0}
</style>
