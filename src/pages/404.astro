---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found | Vithean" description="That page does not exist.">
  <section class="band"><div class="wrap">
    <p class="eyebrow">404</p>
    <h1 class="band-h">That page does not exist.</h1>
    <p class="band-p">It may have moved. Start from the homepage, or look through the product pages.</p>
    <div class="hero-cta">
      <a class="btn btn-fill" href="/en/">Go to the homepage</a>
      <a class="btn btn-line" href="/en/product/accounting/">See the product</a>
    </div>
  </div></section>
</Base>
