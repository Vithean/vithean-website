---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Journal from '@/components/Journal.astro';
import ReportCard from '@/components/ReportCard.astro';
import TrailCard from '@/components/TrailCard.astro';
import CamInvFlow from '@/components/CamInvFlow.astro';
import Zoomable from '@/components/Zoomable.astro';
import { getLangFromUrl, useTranslations, path, DOCS_URL, pick } from '@/i18n/utils';
import { planName, featureLabel } from '@/lib/planDisplay';
import { breadcrumbSchema } from '@/lib/seo';
import { copy, c } from '@/i18n/copy';
import caminvFlowEn from '@/assets/diagrams/caminv-flow.svg?raw';
import caminvFlowKm from '@/assets/diagrams/caminv-flow.km.svg?raw';
import compliancePlacementEn from '@/assets/diagrams/compliance-placement.svg?raw';
import compliancePlacementKm from '@/assets/diagrams/compliance-placement.km.svg?raw';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return [undefined, 'km'].flatMap((lang) =>
    products.map((p) => ({ params: { lang, slug: p.id }, props: { entry: p } })),
  );
}
const lang = getLangFromUrl(Astro.url);
const { entry } = Astro.props;
const d = entry.data;
/** Prose resolved for the locale. Journal/report/trail cards stay English. */
const L = lang === 'km' ? { ...d, ...d.km } : d;
const nav = (e: { data: typeof d }) => (lang === 'km' ? e.data.km.nav : e.data.nav);
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://vithean.com');

const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const plans = (await getCollection('plans')).sort((a, b) => a.data.order - b.data.order);

/**
 * Tier availability, generated from plans.json — never hand-typed.
 * Skipped when the page authors its own `included` block.
 */
const availability = d.featureIds.map((fid) => {
  const label = featureLabel(plans[0]?.data.features.find((f) => f.id === fid), lang);
  const inc = plans.filter((p) => p.data.features.find((f) => f.id === fid)?.included);
  const where = inc.length === plans.length
    ? c(copy.product.everyPlan, lang)
    : inc.map((p) => planName(p.data, lang)).join(', ');
  return { label, where };
});
/* Two files rather than a string swap: the labels sit at fixed x/y inside
   fixed-width boxes, so Khmer needs its own line breaks, not a substitution. */
const caminvFlow = lang === 'km' ? caminvFlowKm : caminvFlowEn;
const compliancePlacement = lang === 'km' ? compliancePlacementKm : compliancePlacementEn;
const others = all.filter((p) => p.id !== entry.id).slice(0, 3);
---
<Base title={L.title} description={L.description} route={`product/${entry.id}/`}
      schemas={[breadcrumbSchema([
        { name: 'Vithean', url: path(lang) },
        { name: 'Product', url: path(lang, 'product/accounting/') },
        { name: L.nav, url: path(lang, `product/${entry.id}/`) },
      ], site)]}>
  <div class="subnav"><div class="wrap subnav-in">
    {all.map((p) => (
      <a class="subpill" href={path(lang, `product/${p.id}/`)}
         aria-current={p.id === entry.id ? 'page' : undefined}>{nav(p)}</a>
    ))}
  </div></div>

  {/* The masthead carries the field so the journal card sits on it as a
      white panel rather than disappearing into a white page. */}
  <section class="band band-head" style="padding-top:var(--s5)"><div class="wrap">
    <div class="prod-head">
      <div>
        <p class="eyebrow">{L.eyebrow}</p>
        <h1 class="band-h">{L.title}</h1>
        <p class="band-p" style="font-size:1.1rem">{L.lead}</p>
        <div class="tiers">
          <p class="tiers-lead">{L.included ? L.included.lead : c(copy.product.includedIn, lang)}</p>
          <ul class="tier-list">
            {L.included
              ? L.included.items.map((item: string) => <li class="tier"><span class="tier-feat">{item}</span></li>)
              : availability.map((a) => (
                  <li class="tier">
                    <span class="tier-feat">{a.label}</span>
                    <b class="tier-plans">{a.where}</b>
                  </li>
                ))}
          </ul>
        </div>
      </div>
      <div>
        <Zoomable>
          {d.visual === 'journal' && d.posts && <Journal j={d.posts} />}
          {d.visual === 'report'  && d.report && <ReportCard r={d.report} />}
          {d.visual === 'trail'   && d.trail  && <TrailCard tr={d.trail} />}
          {d.visual === 'flow' && (
            <div class="journal" style="padding:var(--s3)"><CamInvFlow /></div>
          )}
        </Zoomable>
      </div>
    </div>
  </div></section>

  {/* Three bands, not one. A single section left every product page a solid
      1087px of white — the surface system existed but these pages never opted
      into it. */}
  <section class="band band-tint"><div class="wrap">
    <div class="points">
      {L.points.map((pt) => (
        <div class="point"><h2>{pt.h}</h2><p>{pt.p}</p></div>
      ))}
    </div>

    {entry.id === 'e-invoicing' && (
      <>
      <div class="figures">
        {[
          { svg: caminvFlow, cap: copy.product.figCaminv },
          { svg: compliancePlacement, cap: copy.product.figCompliance },
        ].map((fig) => (
          <figure>
            <Zoomable><div class="figure-box" set:html={fig.svg} /></Zoomable>
            <figcaption>{c(fig.cap, lang)}</figcaption>
          </figure>
        ))}
      </div>

      </>
    )}

    {L.footnote && <p class="footnote">{L.footnote}</p>}
  </div></section>

  {/* A row of links does not need a full band's measure top and bottom; at
      --s6 the split cost the page more height than the tint was worth. */}
  <section class="band" style="padding-block:var(--s5)"><div class="wrap">
    <div class="prod-next">
      {others.map((o) => (
        <a class="btn btn-line" href={path(lang, `product/${o.id}/`)}>{nav(o)} →</a>
      ))}
      <a class="btn btn-ghost" href={DOCS_URL}>{c(copy.product.guide, lang)}</a>
    </div>
  </div></section>
</Base>

<style>
  /* Chips on a field rather than bare text: with a surface of their own the
     row reads as a set of controls, and the deeper bar behind them has
     something to hold. */
  .subpill{font-size:.94rem; font-weight:600; white-space:nowrap; padding:.42rem .95rem;
    border-radius:var(--r-pill); color:var(--ink-muted); text-decoration:none;
    background:var(--surface); border:1px solid var(--line-strong);
    transition:color .12s, border-color .12s}
  .subpill:hover{color:var(--plum-700); border-color:var(--plum-600)}
  .subpill[aria-current]{background:var(--plum-600); border-color:var(--plum-600);
    color:var(--on-plum)}
  .point h2{font-size:1.1rem}
  .figures{margin-top:var(--s6); display:grid; gap:var(--s5)}
  /* min-width:0 or the grid item refuses to shrink below the diagram's
     min-content width (620px), and .figure-box never gets to scroll. */
  .figures figure{margin:0; min-width:0}
  .figure-box{min-width:0}
  .figure-box{background:var(--surface); border:1px solid var(--line-strong);
    border-radius:var(--r-md); padding:1.2rem; box-shadow:var(--shadow-card); overflow-x:auto}
  .figure-box :global(svg.figure){width:100%; height:auto; display:block; min-width:620px}
  .figures figcaption{margin-top:.8rem; font-size:.92rem; color:var(--ink-muted); max-width:68ch}

</style>

