---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { getLangFromUrl, fmtDate, path } from '@/i18n/utils';
import { breadcrumbSchema } from '@/lib/seo';

/**
 * Ids are `<lang>/<slug>`, so one slug can carry both languages and a guide can
 * exist in one language only. hreflang is emitted for the counterpart only when
 * that counterpart is actually built — an alternate pointing at a 404 counts
 * against the page that made the claim.
 */
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const slugsByLang = new Set(guides.map((g) => g.id));

  return guides.map((g) => {
    const [gLang, slug] = g.id.split('/');
    const other = gLang === 'en' ? 'km' : 'en';
    const hasCounterpart = slugsByLang.has(`${other}/${slug}`);
    return {
      params: { lang: gLang === 'en' ? undefined : gLang, slug },
      props: { entry: g, slug, onlyLang: hasCounterpart ? undefined : g.data.lang },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const { entry, slug, onlyLang } = Astro.props;
const { Content } = await render(entry);
const site = Astro.site ?? new URL('https://vithean.com');
const route = `guides/${slug}/`;

/**
 * Article, not WebPage: this is authored editorial with a date and a named
 * publisher, and that is what earns it a rich result.
 */
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  inLanguage: entry.data.lang === 'km' ? 'km-KH' : 'en-US',
  mainEntityOfPage: new URL(entry.data.lang === 'km' ? `/km/${route}` : `/${route}`, site).href,
  publisher: { '@id': new URL('/#organization', site).href },
};
---
<Base title={entry.data.title} description={entry.data.description} route={route}
      onlyLang={onlyLang}
      schemas={[article, breadcrumbSchema([
        { name: 'Vithean', url: path(lang) },
        { name: entry.data.title, url: path(lang, route) },
      ], site)]}>
  <section class="band band-head" style="padding-bottom:var(--s5)"><div class="wrap">
    <p class="eyebrow">Guide</p>
    <h1 class="band-h" style="max-width:24ch">{entry.data.title}</h1>
    <p class="band-p" style="font-size:1.1rem">{entry.data.description}</p>
  </div></section>

  <section class="band" style="padding-top:var(--s5)"><div class="wrap">
    <article class="prose guide">
      <Content />
      <p class="guide-updated">
        Last updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
          {fmtDate(entry.data.updated, lang)}</time>
      </p>
    </article>
  </div></section>
</Base>

<style>
  /* Astro scopes styles per component, so .prose from the news route does not
     reach here. This is the guide's own typography, and it is doing more work:
     a buyer's guide is long-form with comparison tables as its centrepiece,
     not a short announcement. */
  .guide{margin-top:var(--s2); max-width:72ch; font-size:1.06rem; line-height:1.72}
  .guide > * + *{margin-top:1.15rem}

  .guide :global(h2){font-size:1.45rem; letter-spacing:-.02em; margin-top:2.6rem;
    padding-top:1.1rem; border-top:1px solid var(--line)}
  .guide :global(h3){font-size:1.12rem; margin-top:1.9rem}
  .guide :global(h2 + p),.guide :global(h3 + p){margin-top:.7rem}
  .guide :global(strong){color:var(--ink-strong); font-weight:700}
  .guide :global(a){color:var(--plum-600); font-weight:600;
    text-decoration:underline; text-underline-offset:2px;
    text-decoration-color:color-mix(in srgb, var(--plum-600), transparent 65%)}
  .guide :global(a:hover){text-decoration-color:var(--plum-600)}
  .guide :global(ul),.guide :global(ol){padding-left:1.35rem; display:grid; gap:.55rem}
  .guide :global(li)::marker{color:var(--plum-600)}
  .guide :global(hr){border:0; border-top:1px solid var(--line-strong); margin:var(--s5) 0}
  .guide :global(em){color:var(--ink-muted)}

  /* ── comparison tables ─────────────────────────────────────────────
     The reason someone opens this page. Wider than the measure, so the
     wrapper scrolls rather than the row squeezing to illegibility, and the
     first column stays put while the options scroll past it. */
  /* The table is its own scroll container. Astro 7's default Markdown
     processor does not take rehype plugins without swapping the whole
     pipeline, so no wrapper element is emitted — display:block makes the
     table scroll itself instead of dragging the page sideways. */
  .guide :global(table){display:block; overflow-x:auto; max-width:100%;
    margin:var(--s4) 0; border:1px solid var(--line-strong);
    border-radius:var(--radius-md); border-collapse:separate; border-spacing:0;
    font-size:.95rem; white-space:normal}
  .guide :global(thead th){background:var(--surface-muted); text-align:left;
    font-weight:700; color:var(--ink-strong); white-space:nowrap;
    border-bottom:1px solid var(--line-strong)}
  .guide :global(th),.guide :global(td){padding:.72rem .85rem; text-align:left;
    vertical-align:top; border-bottom:1px solid var(--line)}
  .guide :global(tbody tr:last-child th),
  .guide :global(tbody tr:last-child td){border-bottom:0}
  .guide :global(tbody th){font-weight:600; color:var(--ink-strong);
    background:var(--surface); border-right:1px solid var(--line); min-width:11rem}
  .guide :global(tbody tr:hover td){background:var(--tint)}

  /* ── asides, rebuilt from Starlight's ::: directives ───────────────
     The "who wrote this" disclosure has to read as a disclosure. */
  .guide :global(.gnote){margin:var(--s4) 0; padding:1.05rem 1.2rem;
    background:var(--surface-muted); border:1px solid var(--line-strong);
    border-left:3px solid var(--plum-600); border-radius:var(--radius-md)}
  .guide :global(.gnote-caution){border-left-color:var(--brass);
    background:var(--brass-tint); border-color:var(--brass-line)}
  .guide :global(.gnote-h){font-size:.78rem; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; color:var(--ink-muted); margin:0 0 .45rem}
  .guide :global(.gnote > *){margin-top:.6rem}
  .guide :global(.gnote > :last-child){margin-bottom:0}

  /* The diagram is a light-palette SVG, so it keeps a light plate under both
     themes rather than turning into a dark rectangle. */
  .guide :global(img){display:block; max-width:100%; height:auto; margin:var(--s4) 0;
    background:#fff; border:1px solid var(--line-strong);
    border-radius:var(--radius-md); padding:.6rem}

  .guide-updated{margin-top:var(--s5); padding-top:var(--s3);
    border-top:1px solid var(--line-strong); font-size:.92rem; color:var(--ink-muted)}

  @media (max-width:560px){
    .guide{font-size:1.02rem}
    .guide :global(h2){font-size:1.28rem}
  }
</style>
