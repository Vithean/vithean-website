---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { getLangFromUrl, fmtDate, path } from '@/i18n/utils';
import { breadcrumbSchema } from '@/lib/seo';

/**
 * Guides are English-only today, so only the locale a guide declares gets a
 * route. Emitting a /km/ copy of English prose would put a page in the Khmer
 * sitemap that no Khmer reader can use, and hreflang would then advertise a
 * translation that does not exist.
 */
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({
    params: { lang: g.data.lang === 'en' ? undefined : g.data.lang, slug: g.id },
    props: { entry: g },
  }));
}

const lang = getLangFromUrl(Astro.url);
const { entry } = Astro.props;
const { Content } = await render(entry);
const site = Astro.site ?? new URL('https://vithean.com');
const route = `guides/${entry.id}/`;

/**
 * Article, not WebPage: this is authored editorial with a date and a named
 * publisher, and that is what earns it a rich result.
 */
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  inLanguage: 'en-US',
  mainEntityOfPage: new URL(`/${route}`, site).href,
  publisher: { '@id': new URL('/#organization', site).href },
};
---
<Base title={entry.data.title} description={entry.data.description} route={route}
      schemas={[article, breadcrumbSchema([
        { name: 'Vithean', url: path(lang) },
        { name: entry.data.title, url: path(lang, route) },
      ], site)]}>
  <section class="band band-head" style="padding-bottom:var(--s5)"><div class="wrap">
    <p class="eyebrow">Guide</p>
    <h1 class="band-h" style="max-width:24ch">{entry.data.title}</h1>
    <p class="band-p" style="font-size:1.1rem">{entry.data.description}</p>
  </div></section>

  <section class="band" style="padding-top:var(--s5)"><div class="wrap">
    <article class="prose guide">
      <Content />
      <p class="guide-updated">
        Last updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
          {fmtDate(entry.data.updated, lang)}</time>
      </p>
    </article>
  </div></section>
</Base>

<style>
  .guide{max-width:72ch}
  .guide :global(table){width:100%; border-collapse:collapse; margin:var(--s3) 0; font-size:.95rem}
  .guide :global(th),.guide :global(td){text-align:left; padding:.6rem .7rem;
    border-bottom:1px solid var(--line); vertical-align:top}
  .guide :global(thead th){border-bottom:1px solid var(--line-strong); font-weight:700}
  /* The comparison tables are wider than the measure on a phone. */
  .guide :global(table){display:block; overflow-x:auto}

  /* Starlight's ::: asides, rebuilt. Marked as an aside so the disclosure
     about who wrote this reads as a disclosure, not as body copy. */
  .guide :global(.gnote){margin:var(--s4) 0; padding:1rem 1.15rem;
    background:var(--surface-muted); border:1px solid var(--line-strong);
    border-left:3px solid var(--plum-600); border-radius:var(--radius-md)}
  .guide :global(.gnote-caution){border-left-color:var(--brass)}
  .guide :global(.gnote-h){font-size:.82rem; font-weight:700; letter-spacing:.09em;
    text-transform:uppercase; color:var(--ink-muted); margin:0 0 .5rem}
  .guide :global(.gnote p:last-child){margin-bottom:0}

  .guide :global(img){max-width:100%; height:auto; background:var(--logo-plate);
    border-radius:var(--radius-md); padding:4px}
  .guide-updated{margin-top:var(--s5); padding-top:var(--s3);
    border-top:1px solid var(--line-strong); font-size:.92rem; color:var(--ink-muted)}
</style>
