---
import { getLangFromUrl, useTranslations, path, LOGIN_URL, DOCS_URL } from '@/i18n/utils';
import company from '@/data/company.json';
import { getCollection } from 'astro:content';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const ICON: Record<string, string> = {
  facebook:'M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0022 12z',
  linkedin:'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.5 8.65 21 11 21 14.2V21h-4v-6c0-1.4-.03-3.3-2-3.3-2 0-2.3 1.55-2.3 3.2V21H9z',
  instagram:'M12 2.2c3.2 0 3.6 0 4.9.07 3.25.15 4.77 1.7 4.92 4.92.06 1.28.07 1.67.07 4.9s-.01 3.6-.07 4.9c-.15 3.2-1.66 4.77-4.92 4.92-1.3.06-1.68.07-4.9.07s-3.6-.01-4.9-.07c-3.26-.15-4.77-1.72-4.92-4.92C2.11 15.6 2.1 15.2 2.1 12s.01-3.6.08-4.9C2.33 3.96 3.84 2.42 7.1 2.27 8.4 2.21 8.8 2.2 12 2.2zm0 3.36A6.44 6.44 0 1018.44 12 6.44 6.44 0 0012 5.56zm0 10.62A4.18 4.18 0 1116.18 12 4.18 4.18 0 0112 16.18zm6.7-10.87a1.5 1.5 0 11-1.5-1.5 1.5 1.5 0 011.5 1.5z',
  youtube:'M21.6 7.2s-.2-1.4-.8-2c-.75-.8-1.6-.8-2-.85C16 4.2 12 4.2 12 4.2h-.01s-4 0-6.8.2c-.4.05-1.24.05-2 .85-.6.6-.8 2-.8 2S2.2 8.8 2.2 10.5v1.6c0 1.6.2 3.3.2 3.3s.2 1.4.8 2c.76.8 1.75.77 2.2.86 1.6.15 6.8.2 6.8.2s4 0 6.8-.21c.4-.05 1.25-.06 2-.86.6-.6.8-2 .8-2s.2-1.65.2-3.3v-1.6c0-1.65-.2-3.3-.2-3.3zM9.9 14.6V8.9l5.15 2.86z',
  telegram:'M21.9 4.3L2.9 11.6c-1.3.5-1.3 1.25-.24 1.57l4.86 1.52 1.87 5.73c.23.62.11.87.77.87.5 0 .73-.23 1-.5l2.35-2.28 4.9 3.6c.9.5 1.54.24 1.77-.83l3.2-15.1c.33-1.3-.5-1.9-1.5-1.5z',
  tiktok:'M16.6 5.82A4.28 4.28 0 0115.54 3h-3.09v12.4a2.59 2.59 0 01-2.59 2.5 2.59 2.59 0 110-5.18c.27 0 .52.04.77.11v-3.1a5.7 5.7 0 00-.77-.05A5.68 5.68 0 1015.54 15.4V9.01a7.35 7.35 0 004.3 1.38V7.3a4.28 4.28 0 01-3.24-1.48z',
};
const LABEL: Record<string, string> = { facebook:'Facebook', linkedin:'LinkedIn', instagram:'Instagram', youtube:'YouTube', telegram:'Telegram', tiktok:'TikTok' };
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div>
        <img src="/assets/logo-full.png" alt="Vithean" width="440" height="129" />
        <p style="margin-top:.9rem;font-size:.95rem;color:var(--ink-muted);max-width:34ch">{t('foot.tagline')}</p>
      </div>
      <div><h4>{t('foot.product')}</h4><ul>
        {products.map((p) => <li><a href={path(lang, `product/${p.id}/`)}>{lang === 'km' ? p.data.km.nav : p.data.nav}</a></li>)}
        <li><a href={path(lang, 'pricing/')}>{t('nav.pricing')}</a></li></ul></div>
      <div><h4>{t('foot.platform')}</h4><ul>
        <li><a href={DOCS_URL}>{t('foot.docs')}</a></li>
        <li><a href={LOGIN_URL}>{t('foot.login')}</a></li>
        {company.platform.portalLive && (
          <li><a href={company.platform.portal}>{t('foot.account')}</a></li>
        )}
        <li><a href={path(lang, 'product/control/')}>{t('foot.security')}</a></li></ul></div>
      <div><h4>{t('foot.company')}</h4><ul>
        <li><a href={path(lang, 'company/')}>{t('nav.company')}</a></li>
        <li><a href={path(lang, 'news/')}>{t('nav.news')}</a></li>
        <li><a href={path(lang, 'support/')}>{t('nav.support')}</a></li>
        <li><a href={path(lang, 'company/#contact')}>{t('foot.contact')}</a></li></ul></div>
    </div>

    <div class="ftr-strip">
      <div><h4>{t('foot.accept')}</h4>
        <img class="pay" src="/assets/we-accept.png" width="560" height="52"
             alt={company.payments.methods.join(', ')} /></div>
      <div><h4>{t('foot.follow')}</h4>
        <div class="social">
          {Object.entries(company.social).map(([k, url]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={LABEL[k]} title={LABEL[k]}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON[k]} /></svg></a>
          ))}
        </div></div>
    </div>

    <div class="ftr-bottom">
      <span>© {year} {company.legalName} ·
        <a href={company.contact.mapUrl} target="_blank" rel="noopener">{t('foot.city')}</a></span>
      <span>
        <a href={path(lang, 'term-condition/')}>{t('foot.terms')}</a> ·
        <a href={path(lang, 'privacy-policy/')}>{t('foot.privacy')}</a> ·
        {/* Actionable, not decorative: on a phone this line is the shortest
            path to a conversation, and plain text made it a dead end. */}
        <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a> ·
        <a href={`tel:${company.contact.phoneTel}`}>{company.contact.phonePrimary}</a>
      </span>
      {/*
          A select rather than a segmented control: this is a set-once
          preference sitting in the legal line, not a primary action, and a
          native picker costs one line of chrome instead of three pills.
          Three options, not a toggle — a binary switch has no way back to
          "follow the machine" once it has been touched.
      */}
      <span class="themepick">
        <label for="vth-theme">{t('theme.label')}</label>
        <select id="vth-theme" name="vth-theme">
          <option value="system">{t('theme.system')}</option>
          <option value="light">{t('theme.light')}</option>
          <option value="dark">{t('theme.dark')}</option>
        </select>
      </span>
    </div>
  </div>
</footer>

<script>
  /* The control is hydrated here; Base.astro has already applied the stored
     theme to <html> before paint. This only reflects that state into the
     select and writes changes back.

     "system" removes the attribute rather than resolving light/dark itself,
     so the CSS media query keeps ownership and the page follows the machine
     live — including when the OS flips while the tab is open. */
  const KEY = 'vth-theme';
  const root = document.documentElement;
  const sel = document.querySelector<HTMLSelectElement>('#vth-theme');

  if (sel) {
    const read = () => {
      try { return localStorage.getItem(KEY) || 'system'; } catch { return 'system'; }
    };

    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    /* 'system' is resolved here rather than left to CSS: the attribute has to
       carry a concrete value for PrimeVue's dark selector to match. Storage
       still holds nothing for system, so the choice itself stays "follow the
       machine". */
    const paint = (mode: string) => {
      root.dataset.theme = mode === 'system' ? (mq.matches ? 'dark' : 'light') : mode;
    };

    /* The OS flipped while the tab is open. Only follow it if the visitor has
       not picked a side. */
    mq.addEventListener('change', () => { if (read() === 'system') paint('system'); });

    sel.value = read();

    sel.addEventListener('change', () => {
      const mode = sel.value;
      paint(mode);
      try {
        if (mode === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, mode);
      } catch { /* private mode: the choice holds for this page only */ }
    });

    /* Another tab changed it. Mirror rather than fight. */
    window.addEventListener('storage', (e) => {
      if (e.key !== KEY) return;
      const m = e.newValue || 'system';
      paint(m);
      sel.value = m;
    });
  }
</script>

<style>
  /* Sits in the legal line, so it inherits that line's scale and colour and
     adds no new visual weight to the footer. */
  .themepick{display:inline-flex; align-items:center; gap:.45rem}
  .themepick label{color:var(--ink-muted)}
  .themepick select{font:inherit; font-size:inherit; color:var(--ink-muted);
    background:var(--surface); border:1px solid var(--line-strong);
    border-radius:var(--r-sm); padding:.16rem 1.5rem .16rem .5rem; cursor:pointer;
    /* Native arrow removed for one that matches the ink, drawn in the
       background so the control keeps its native keyboard behaviour. */
    appearance:none;
    background-image:url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 6'%3E%3Cpath d='M1 1l4 4 4-4' fill='none' stroke='%238C8499' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat:no-repeat; background-position:right .5rem center; background-size:.6rem}
  .themepick select:hover{color:var(--ink-strong); border-color:var(--plum-600)}
  .themepick select:focus-visible{outline:2px solid var(--plum-600); outline-offset:1px}
</style>
