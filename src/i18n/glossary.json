{
  "schemaVersion": "1.0.0",
  "note": "Khmer accounting vocabulary, extracted from the product's own locale files. The website MUST use these words. Two terminologies for the same thing across the product, the site and support is the most common self-inflicted trust problem in bilingual finance software — and in a finance product it reads as unreliability.",
  "sources": [
    "vithean-ui/src/locale/km.js",
    "vithean-myweb/i18n/km.json",
    "vithean-central-web/i18n/km/*.js"
  ],
  "rule": "If a term is here, use it verbatim. If it is not, translate it properly and add it here so the next person does not invent a second word.",
  "englishByDefault": {
    "decision": "Demo figures, document references and account names stay in ENGLISH on both locales.",
    "why": "Most Cambodian accountants work in English for the ledger itself. INV-2026-0412, 'Accounts receivable' and '3,960.00' read correctly to the audience in English, and translating them would make the example harder to verify, not easier.",
    "applies": [
      "journal cards",
      "the margin report",
      "the approval trail",
      "document references"
    ]
  },
